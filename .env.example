# Application
NODE_ENV=development
PORT=3000
TZ=Africa/Abidjan

# Base de données (MySQL 8)
DATABASE_URL=mysql://user:password@127.0.0.1:3306/commandes

# Authentification (JWT_SECRET : clé aléatoire d'au moins 32 caractères)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# URL du backoffice
CORS_ORIGIN=http://localhost:5173

# WhatsApp Cloud API (Meta)
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WABA_ID=
GRAPH_API_VERSION=

# Bot
DRAFT_TTL_MINUTES=30

# Compte admin créé par le seed
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrateur
ADMIN_PASSWORD=

# Reçus PDF (A5 ou TICKET80)
RECEIPT_COMPANY_NAME=
RECEIPT_FORMAT=A5
